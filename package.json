{
  "name": "lzxreader",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/test-markdown-preprocess.mjs && node --experimental-strip-types scripts/test-math-render.mjs && node --experimental-strip-types scripts/test-file-tree.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "verify": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.1",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~51.0.28",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-status-bar": "~1.12.1",
    "highlight.js": "^11.9.0",
    "mathjax-full": "^3.2.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-marked": "^6.0.7",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.8.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "eas-cli": "^21.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "prettier": "^3.3.3",
    "typescript": "~5.3.3"
  },
  "private": true
}
