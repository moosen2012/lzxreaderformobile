# Learn more https://docs.expo.io/guides/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# generated native files
android/
ios/

# 例外：自定义 Expo 原生模块的源码必须入库（否则全新 clone 无法构建 SAF 模块）
# 只放行 modules/*/android 下的源码，build 产物仍然忽略
!/modules/*/android/
/modules/*/android/build/
/modules/*/android/.gradle/

# Typescript
*.tsbuildinfo

# Lint / format
.eslintcache

# 临时调试文件
.tmp-*
*.log

# 本地工作记忆
.workbuddy/
